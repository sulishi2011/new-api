# New-API 线上 docker-compose.yml 配置样例
#
# 用法：
#   1. 按需把本文件内容复制到 .env
#   2. 把所有 replace_* 占位值改成真实值
#   3. 不要提交 .env，项目的 .gitignore 已经忽略 .env
#
# 生成 SESSION_SECRET / CRYPTO_SECRET：
#   openssl rand -hex 32
#
# 注意：
#   AWS_RDS_PASSWORD 和 REDIS_PASSWORD 会被拼进 URL。
#   如果密码里包含 @ : / ? # % 等 URL 特殊字符，请先做 URL 编码。

# ---------------------------------------------------------------------------
# 实例身份和端口
# ---------------------------------------------------------------------------

# 宿主机对外暴露的端口。访问地址会是 http://服务器IP:APP_PORT
APP_PORT=3000

# new-api 容器名。同一台机器跑多个实例时，每个实例必须不同。
NEW_API_CONTAINER_NAME=new-api

# Redis 容器名。同一台机器跑多个实例且每个实例自带 Redis 时，每个实例必须不同。
REDIS_CONTAINER_NAME=redis

# 当前节点名称，用于日志、管理后台、故障排查中区分节点。
NODE_NAME=new-api-node-1

# 容器内临时文件目录。trace full body spool 会跟随系统临时目录，
# docker-compose.yml 默认把 /data 挂到宿主机 ./data。
TMPDIR=/data/tmp

# 第二个实例示例：
#   APP_PORT=3001
#   NEW_API_CONTAINER_NAME=new-api-2
#   REDIS_CONTAINER_NAME=redis-2
#   NODE_NAME=new-api-node-2
# 多实例共用同一套数据库/Redis 时，SESSION_SECRET 和 CRYPTO_SECRET 必须保持一致。

# ---------------------------------------------------------------------------
# 必填密钥
# ---------------------------------------------------------------------------

# RDS PostgreSQL 用户名。默认通常是 admin。
AWS_RDS_USER=admin

# RDS PostgreSQL 密码。会用于 SQL_DSN / LOG_SQL_DSN / SQL_READ_DSN / LOG_SQL_READ_DSN。
AWS_RDS_PASSWORD=replace_with_url_encoded_rds_password

# 主业务数据库名，保存用户、渠道、令牌、配置等核心数据。
AWS_RDS_APP_DB=new-api

# 日志数据库名，保存消费日志、错误日志、管理日志等。
AWS_RDS_LOG_DB=new-api-logs

# Redis 密码。会用于应用连接 Redis，也会用于 Redis 容器启动参数。
REDIS_PASSWORD=replace_with_url_encoded_redis_password

# Web 登录 session 签名密钥。必须固定；容器重启或多实例部署时不能变化。
SESSION_SECRET=replace_with_64_hex_chars

# Redis token cache 等 HMAC 相关逻辑使用的密钥。多实例部署时必须一致。
CRYPTO_SECRET=replace_with_another_64_hex_chars

# ---------------------------------------------------------------------------
# 运行模式
# ---------------------------------------------------------------------------

# 是否把上游请求失败等错误写入数据库错误日志。true 便于排查，日志量也会增加。
ERROR_LOG_ENABLED=true

# 多实例/Redis 缓存同步频率，单位秒。越小同步越快，但后台查询更频繁。
SYNC_FREQUENCY=60

# ---------------------------------------------------------------------------
# 数据库连接池
# ---------------------------------------------------------------------------

# 每个数据库连接池保留的最大空闲连接数。太高会长期占用 RDS 连接；太低会增加突发流量下的建连开销。
SQL_MAX_IDLE_CONNS=10

# 每个数据库连接池允许同时打开的最大连接数。
# 注意：应用有主库、日志库、读库、日志读库等多个连接池，总连接数会叠加。
SQL_MAX_OPEN_CONNS=30

# 数据库连接最大生命周期，单位秒。到期后连接会被回收重建。
SQL_MAX_LIFETIME=300

# ---------------------------------------------------------------------------
# Redis 连接池
# ---------------------------------------------------------------------------

# 应用连接 Redis 的连接池大小。请求量高或 Redis 操作多时可适当增大。
REDIS_POOL_SIZE=30

# ---------------------------------------------------------------------------
# 上游请求连接池和请求限制
# ---------------------------------------------------------------------------

# 应用访问上游 AI 服务时，HTTP 客户端最多保留的全局空闲连接数。影响连接复用，不限制并发请求数。
RELAY_MAX_IDLE_CONNS=500

# 应用访问同一个上游域名时，最多保留的空闲连接数。影响连接复用，不限制并发请求数。
RELAY_MAX_IDLE_CONNS_PER_HOST=100

# 请求体最大大小，单位 MB。用于防止超大请求或解压后的 zip bomb 撑爆内存。
MAX_REQUEST_BODY_MB=32

# 流式响应扫描器单行最大缓冲，单位 MB。图片/base64 数据很大时可能需要调高。
STREAM_SCANNER_MAX_BUFFER_MB=64

# 流式请求无响应超时时间，单位秒。上游长时间不返回数据时会超时。
STREAMING_TIMEOUT=300

# 后台异步任务每次查询的任务数量上限。任务量大时可适当增大。
TASK_QUERY_LIMIT=100

# ---------------------------------------------------------------------------
# 数据库日志保留策略
# ---------------------------------------------------------------------------

# 是否启用数据库日志自动清理。true 可以防止 logs 表无限增长。
LOG_RETENTION_ENABLED=true

# 消费日志保留天数。4000 RPM 量级建议 7 到 30 天，不建议长期保留原始明细。
LOG_RETENTION_CONSUME_DAYS=14

# 错误日志保留天数。用于排查上游故障和用户请求失败。
LOG_RETENTION_ERROR_DAYS=30

# 系统日志保留天数。
LOG_RETENTION_SYSTEM_DAYS=90

# 管理操作日志保留天数。涉及审计，通常比消费日志保留更久。
LOG_RETENTION_MANAGE_DAYS=180

# 充值日志保留天数。0 表示不自动删除，适合财务记录。
LOG_RETENTION_TOPUP_DAYS=0

# 退款日志保留天数。0 表示不自动删除，适合财务记录。
LOG_RETENTION_REFUND_DAYS=0

# 日志清理任务执行间隔，单位小时。
LOG_CLEANUP_INTERVAL_HOURS=24

# 每批删除的日志行数。越大清理越快，但对数据库瞬时压力越大。
LOG_CLEANUP_BATCH_SIZE=1000

# 每批删除之间的休眠时间，单位毫秒。用于降低清理任务对 RDS 的压力。
LOG_CLEANUP_BATCH_SLEEP_MS=200

# ---------------------------------------------------------------------------
# S3 Trace 存储
# ---------------------------------------------------------------------------
#
# 这部分不是把普通 logs 表整体搬到 S3。
# 它的作用是把详细 request/response trace payload 压缩后存到 S3，
# 数据库里只保留轻量日志和 log_traces 元数据。
#
# 推荐同时在 S3 Bucket 配生命周期：
#   前缀：new-api/traces/
#   过期删除：8 天
#   未完成分段上传清理：1 天

# 是否启用 S3 trace 存储。没有配置好 S3/IAM 前建议保持 false。
TRACE_STORAGE_ENABLED=false

# Trace 存储后端。目前代码支持 s3。
TRACE_STORAGE_BACKEND=s3

# Trace 元数据保留天数。S3 对象删除还需要配置 S3 lifecycle。
TRACE_RETENTION_DAYS=7

# Trace 捕获模式：
#   error：只捕获错误请求
#   all：捕获全部请求，日志量和 S3 成本会明显增加
#   sample：按 TRACE_SUCCESS_SAMPLE_RATE 采样成功请求，错误请求仍捕获
#   off / none / disabled：关闭捕获
TRACE_CAPTURE_MODE=error

# sample 模式下成功请求采样比例，0 到 100。TRACE_CAPTURE_MODE=sample 时生效。
TRACE_SUCCESS_SAMPLE_RATE=0

# 是否异步上传 trace 到 S3。true 可以减少正常请求阻塞。
TRACE_UPLOAD_ASYNC=true

# 错误请求是否同步上传 trace。true 更利于错误排查，但错误响应路径会多等 S3 上传。
TRACE_UPLOAD_SYNC_FOR_ERROR=true

# 是否启用 S3 批量上传。开启后错误和成功 trace 都进入后台队列批量写入；
# TRACE_UPLOAD_SYNC_FOR_ERROR 不再让错误 trace 同步写 S3。
TRACE_UPLOAD_BATCH_ENABLED=false

# 批量上传 worker 数。多 worker 可提升全量 trace 场景下的 S3 写入吞吐。
# 兼容旧变量 TRACE_UPLOAD_WORKERS；同时配置时以 TRACE_UPLOAD_BATCH_WORKERS 为准。
TRACE_UPLOAD_BATCH_WORKERS=1

# 批量上传内存队列长度。队列满时不阻塞 API 请求，会丢弃该条 trace 并记录系统日志。
TRACE_UPLOAD_QUEUE_SIZE=1000

# 每个 S3 批量对象最多包含的 trace 条数。
TRACE_UPLOAD_BATCH_SIZE=100

# 批量未满时的最大等待秒数。管理员查看 trace 可能会有这个量级的短延迟。
TRACE_UPLOAD_BATCH_FLUSH_INTERVAL_SECONDS=2

# 单个批量对象的原始 JSON 大小上限，超过后会拆成多个 S3 对象。
TRACE_UPLOAD_BATCH_MAX_BYTES=8388608

# 是否把完整 request/response body 旁路写入 S3 body object。
# 仅 TRACE_CAPTURE_MODE=all 时生效；关闭后仍保留 64KB preview trace。
TRACE_FULL_BODY_ENABLED=true

# 单条 trace 的完整 body 最大保存字节数。0 表示不限制，不建议在生产使用。
TRACE_FULL_BODY_MAX_BYTES=20971520

# S3 Bucket 名称。TRACE_STORAGE_ENABLED=true 时必须填写。
TRACE_S3_BUCKET=

# S3 区域。AWS us-east-1 就保持默认。
TRACE_S3_REGION=us-east-1

# 自定义 S3 兼容服务 endpoint。使用 AWS S3 时留空。
TRACE_S3_ENDPOINT=

# S3 Access Key。EC2/ECS 有 IAM Role 时留空。
TRACE_S3_ACCESS_KEY_ID=

# S3 Secret Key。EC2/ECS 有 IAM Role 时留空。
TRACE_S3_SECRET_ACCESS_KEY=

# S3 对象前缀。所有 trace 对象会写到这个目录前缀下。
TRACE_S3_PREFIX=new-api/traces

# 是否使用 path-style S3 地址。AWS S3 通常 false；MinIO/R2 等兼容服务可能需要 true。
TRACE_S3_FORCE_PATH_STYLE=false

# S3 服务端加密方式。AES256 表示 SSE-S3；不用服务端加密可留空。
TRACE_S3_SSE=AES256
